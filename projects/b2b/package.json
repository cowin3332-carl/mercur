{
  "name": "mercur-b2b",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration:http": "turbo run test:integration:http",
    "test:integration:modules": "turbo run test:integration:modules",
    "test:unit": "turbo run test:unit",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "pnpm --filter @b2b-starter/backend exec medusa db:migrate",
    "seed": "pnpm --filter @b2b-starter/backend exec medusa exec ./src/scripts/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "dev:backend": "pnpm --filter @b2b-starter/backend dev",
    "dev:storefront": "pnpm --filter @b2b-starter/storefront dev",
    "typecheck": "pnpm --filter @b2b-starter/backend exec tsc --noEmit && pnpm --filter @b2b-starter/storefront exec tsc --noEmit"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.13.0",
    "jiti": "^2.7.0",
    "turbo": "^2.3.3"
  }
}
